{
  "title": "Kyiv Vodokanal",
  "config": {
    "step": {
      "user": {
        "description": "Sign in with your [Kyivvodokanal personal account]({portal_url}). Google sign-in is not supported.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate",
        "description": "The password for {email} no longer works. Enter the current password.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid email or password.",
      "cannot_connect": "Failed to connect to Kyivvodokanal."
    },
    "abort": {
      "already_configured": "This account is already configured.",
      "unique_id_mismatch": "You signed in to a different account. Use the account this entry was set up with."
    }
  },
  "device": {
