      "last_payment": {
        "name": "Last payment"
      },
      "last_payment_date": {
        "name": "Last payment date"
      },
      "water_supply": {
        "name": "Water supply tariff"
      },
      "wastewater": {
        "name": "Wastewater tariff"
      },
      "subscription_fee": {
        "name": "Subscription fee"
